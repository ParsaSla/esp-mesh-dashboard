MESH_TRANSPORT=serial
MESH_SERIAL_PORT=COM3
# MESH_SERIAL_PORT=COM3
# MESH_TRANSPORT=tcp
MESH_HOST=192.168.1.100
MESH_PORT=8080
MESH_NODE_ID=node-001
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8000

# AI Assistant Configuration (OpenCode Console)
AI_PROVIDER=opencode
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://opencode.ai/inference/openai/v1
AI_MODEL=deepseek-v4.1-flash-free

# For other OpenAI-compatible providers, use AI_PROVIDER=deepseek and set their
# matching AI_BASE_URL and AI_MODEL (for example: https://api.deepseek.com / deepseek-chat).
